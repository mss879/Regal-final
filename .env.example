# Regal Victoria Lakeside — environment variables
# Copy this file to .env.local for local development, and add the same values to your
# hosting provider's environment settings for production. Never commit .env.local.

# --- Supabase -----------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API (Data API / API Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). The legacy "anon" key also works.
# Safe to expose, but this app only ever uses it on the server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY — bypasses row-level security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Analytics & spam protection ----------------------------------------------------
# Random secret used to hash visitor IPs (they are never stored). Generate with:
#   openssl rand -hex 32
ANALYTICS_SALT=

# --- Optional -------------------------------------------------------------------
# Google Search Console HTML-tag verification code (just the content="..." value).
GOOGLE_SITE_VERIFICATION=

# --- AI assistant (website chat) ------------------------------------------------
# OpenAI API key: platform.openai.com/api-keys. SERVER ONLY — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional: model for the assistant (default gpt-6-luna).
OPENAI_MODEL=
